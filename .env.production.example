# Configuracao de producao para service.sensorpoint.pt.
# Introduzir os segredos diretamente nas variaveis de ambiente do Plesk.
# Nao enviar nem guardar o client secret neste ficheiro.

FS_STORAGE_BACKEND=graph
FS_AUTH_PROVIDER=microsoft
FS_SECRET_KEY=<gerar-chave-aleatoria-longa>
# Ativar apenas depois de instalar Chromium e confirmar backup da pasta privada.
FS_MAINTENANCE_ENABLED=false

FS_APP_DATA_DIR=/var/www/vhosts/service.sensorpoint.pt/private/folhas-servico
FS_LOG_ENABLED=true
FS_LOG_LEVEL=INFO
FS_LOG_DIR=/var/www/vhosts/service.sensorpoint.pt/private/folhas-servico/logs
FS_LOG_FILE_NAME=folhas-servico.jsonl
FS_LOG_MAX_BYTES=10485760
FS_LOG_BACKUP_COUNT=10
FS_LOG_STDERR=true
FS_LOG_REQUESTS=true
FS_EDIT_SESSION_SECONDS=2592000
FS_STATE_DB_BUSY_MS=10000
FS_GRAPH_REFRESH_SECONDS=30
FS_GRAPH_JOB_STALE_SECONDS=900
# O Passenger serve apenas HTTP; uma tarefa agendada executa a fila persistente.
FS_GRAPH_QUEUE_IN_WEB=false

GRAPH_CACHE_DIR=/var/www/vhosts/service.sensorpoint.pt/private/folhas-servico/graph-cache

GRAPH_TENANT_ID=afc2679b-0121-4a82-ab15-59c783daedc9
GRAPH_CLIENT_ID=b233caa9-f51f-4d06-91fe-aa6cf26a982a
GRAPH_CLIENT_SECRET=<introduzir-no-plesk-nao-incluir-no-pacote>
GRAPH_SITE_ID=sensorpointpt.sharepoint.com,8f709e50-0cf3-4a4e-abcf-f13fbdd160fd,27bb0914-7252-4a37-aea3-901d38646005
GRAPH_DRIVE_ID=b!UJ5wj_MMTkqrz_E_vdFg_RQJuydScjdKrqOQHThkYAUGXH3i2HPlT5uigZIXMAjU
GRAPH_ACTIVE_PATH=Aplicação/Activas
GRAPH_ARCHIVE_PATH=Aplicação/Arquivadas
GRAPH_WORKS_PATH=07-Obras/Obras a realizar
GRAPH_WORKS_CACHE_SECONDS=300
GRAPH_SHAREPOINT_HOSTNAME=sensorpointpt.sharepoint.com
# Esta identidade GRAPH_* é também usada pelo login Microsoft e pelo envio de e-mail.
# Existe apenas um client secret da aplicação configurado no Plesk.

# E-mail opcional da folha final: quando preenchido, cliente em Para e apenas o técnico autenticado em CC.
FS_MAIL_ENABLED=true
FS_MAIL_SENDER=service@sensorpoint.pt
FS_MAIL_TEST_RECIPIENT=
FS_MAIL_JOB_MAX_ATTEMPTS=3
FS_MAIL_JOB_STALE_SECONDS=900
# A folha continua a usar o fluxo Graph; os PDFs SADI sao gerados localmente na app.
# Em Plesk/Passenger, instalar Chromium ou apontar para o executavel existente.
# O Dockerfile ja inclui Chromium.
# FS_PDF_BROWSER_PATH=/usr/bin/chromium

# Notificação Teams desativada até ser escolhido o respetivo trigger externo.
FS_TEAMS_NOTIFICATIONS_ENABLED=false
FS_TEAMS_WEBHOOK_URL=

MICROSOFT_AUTH_REDIRECT_URI=https://service.sensorpoint.pt/auth/microsoft/callback
MICROSOFT_AUTH_ALLOWED_DOMAINS=sensorpoint.pt,sensorpoint.com
