# Modo local por defeito
FS_STORAGE_BACKEND=local

# Autenticação:
# none = sem login local, microsoft = login Microsoft Entra, local = passwords locais SQLite
FS_AUTH_PROVIDER=none

# Sessao recuperavel, timeout SQLite e intervalo minimo do refresh SharePoint.
FS_EDIT_SESSION_SECONDS=2592000
FS_STATE_DB_BUSY_MS=10000
FS_GRAPH_REFRESH_SECONDS=30
FS_GRAPH_JOB_STALE_SECONDS=900
# No modo local, a propria app processa a fila. Em Passenger/Plesk usar false
# e executar ``python -m src.queue_worker`` numa tarefa agendada separada.
FS_GRAPH_QUEUE_IN_WEB=true
# Em producao: usar disco local persistente, fora do OneDrive/NFS/SMB.
# FS_APP_DATA_DIR=C:\Sensorpoint\FolhasServico\data

# Logging operacional JSON Lines. Por defeito fica em FS_APP_DATA_DIR\logs.
FS_LOG_ENABLED=true
FS_LOG_LEVEL=INFO
# Se definido, FS_LOG_DIR tem de ser absoluto e ficar em disco local privado.
# FS_LOG_DIR=C:\Sensorpoint\FolhasServico\data\logs
FS_LOG_FILE_NAME=folhas-servico.jsonl
FS_LOG_MAX_BYTES=10485760
FS_LOG_BACKUP_COUNT=10
FS_LOG_STDERR=true
FS_LOG_REQUESTS=true

# Login Microsoft Entra
# O login, o SharePoint e o e-mail usam a mesma identidade GRAPH_* abaixo.
# Para teste local, adicionar este Redirect URI na App Registration:
# http://127.0.0.1:5001/auth/microsoft/callback
MICROSOFT_AUTH_REDIRECT_URI=http://127.0.0.1:5001/auth/microsoft/callback
MICROSOFT_AUTH_ALLOWED_DOMAINS=sensorpoint.pt,sensorpoint.com

# Para testar Microsoft Graph localmente, copia este ficheiro para .env e troca:
# FS_STORAGE_BACKEND=graph

# Identidade única da App Registration Microsoft Graph / Entra
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=
GRAPH_ACTIVE_PATH=Activas
GRAPH_ARCHIVE_PATH=Arquivadas
GRAPH_WORKS_PATH=07-Obras/Obras a realizar
GRAPH_WORKS_CACHE_SECONDS=300
GRAPH_SHAREPOINT_HOSTNAME=sensorpointpt.sharepoint.com

# Envio da folha final por e-mail (Microsoft Graph)
# Em modo local, o HTML final é convertido em PDF por Chrome/Chromium/Edge.
# Em modo Graph/Plesk, o Microsoft Graph converte o HTML final já publicado.
# O Graph é usado apenas para o envio e requer a permissão de aplicação Mail.Send.
FS_MAIL_ENABLED=false
FS_MAIL_SENDER=service@sensorpoint.pt
# Uma falha transitória é repetida no máximo este número de vezes.
FS_MAIL_JOB_MAX_ATTEMPTS=3
# Um envio sem atualização durante este período fica parado para repetição manual.
FS_MAIL_JOB_STALE_SECONDS=900
# Modo de teste: se preenchido, substitui o destinatário quando existe e-mail do cliente.
# Se o campo do cliente ficar vazio, não é enviado qualquer e-mail, mesmo em modo de teste.
# Em produção deve ficar vazio para usar o campo E-mail da folha.
FS_MAIL_TEST_RECIPIENT=
# Aviso num canal/chat através de um Teams Workflow. O URL é secreto.
FS_TEAMS_NOTIFICATIONS_ENABLED=false
FS_TEAMS_WEBHOOK_URL=
# Opcional; Chrome/Edge é detetado automaticamente.
FS_PDF_BROWSER_PATH=
# Perfil temporário gravável usado pelo Chrome/Edge na conversão para PDF.
# Deixar vazio para usar a pasta temporária do sistema ou indicar disco local fora do OneDrive.
FS_PDF_TEMP_DIR=
# Evitar. Usar apenas num servidor cujo sandbox Chromium não esteja disponível.
FS_PDF_BROWSER_NO_SANDBOX=false

# Cache local usada quando FS_STORAGE_BACKEND=graph.
# Em produção aponta isto para uma pasta fora do OneDrive.
# GRAPH_CACHE_DIR=C:\Sensorpoint\FolhasServico\graph-cache
