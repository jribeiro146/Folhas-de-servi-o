# Referência sem credenciais. Não substitui o lançador de testes isolados.
# Para testar: python -B tools/run_test_version.py
FS_ENVIRONMENT=test
FS_STORAGE_BACKEND=local
FS_MAIL_ENABLED=false
FS_TEAMS_NOTIFICATIONS_ENABLED=false
FS_GRAPH_QUEUE_IN_WEB=false
# Para uma instalação com Microsoft: definir AUTH_PROVIDER e URI explicitamente.
FS_AUTH_PROVIDER=none
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=
GRAPH_ACTIVE_PATH=Activas
GRAPH_ARCHIVE_PATH=Arquivadas
FS_MAIL_SENDER=
FS_MAIL_TEST_RECIPIENT=
FS_TEAMS_WEBHOOK_URL=
MICROSOFT_AUTH_REDIRECT_URI=
MICROSOFT_AUTH_ALLOWED_DOMAINS=sensorpoint.pt,sensorpoint.com
# Gerar uma chave própria para uma instalação; não reutilizar a chave operacional.
FS_SECRET_KEY=
# PDF: a imagem Docker define /usr/bin/chromium e HOME=/home/appuser.
# Fora de Docker, deixar o navegador ser detetado ou indicar o executável.
# FS_PDF_BROWSER_PATH=/caminho/para/chromium
# Não desativar o sandbox por defeito. Ver documentacao/10_ALOJAMENTO_DOCKER.md.
FS_PDF_BROWSER_NO_SANDBOX=false
# FS_PDF_TEMP_DIR=/pasta/temporaria/com/escrita
# Tag da imagem candidata para Compose; definir uma tag de release ao publicar.
FS_IMAGE=folhas-servico:local
